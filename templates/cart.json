        "custom_liquid": "<style>\n.shopify-section-group-header-group,\n.shopify-section-group-footer-group,\n.shopify-section:has(.ml-form-embedContainer) {\n  display: none !important;\n}\n.cart-header {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  padding-top: 2.4rem;\n  padding-bottom: 2.4rem;\n}\n.cart-header__logo {\n  grid-column: 2;\n  width: {{ settings.logo_width }}px;\n  height: auto;\n}\n.cart-header localization-form {\n  justify-self: end;\n}\n@media screen and (max-width: 749px) {\n  .cart-header {\n    grid-template-columns: minmax(0, 20rem) auto;\n    justify-content: space-between;\n    column-gap: 1rem;\n    padding-top: 1.2rem;\n    padding-bottom: 1.2rem;\n  }\n  .cart-header__logo {\n    grid-column: 1;\n    width: 100%;\n  }\n  .cart-header .country-selector.disclosure__list-wrapper {\n    top: auto;\n    bottom: -1rem;\n  }\n}\n</style>\n<div class=\"cart-header page-width header-localization\">\n  {%- if settings.logo -%}\n    {{ settings.logo | image_url: width: 900 | image_tag: class: 'cart-header__logo', alt: shop.name }}\n  {%- else -%}\n    <span class=\"cart-header__logo h2 center\">{{ shop.name }}</span>\n  {%- endif -%}\n  {%- if localization.available_countries.size > 1 -%}\n    <localization-form>\n      {%- form 'localization', id: 'CartHeaderCountryForm', class: 'localization-form' -%}\n        <div>\n          <h2 class=\"visually-hidden\" id=\"CartHeaderCountryLabel\">{{ 'localization.country_label' | t }}</h2>\n          {%- render 'country-localization', localPosition: 'CartHeaderCountry' -%}\n        </div>\n      {%- endform -%}\n    </localization-form>\n  {%- endif -%}\n</div>",
