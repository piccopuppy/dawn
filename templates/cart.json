    "collapsible_content_Bfj6Fi": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_PiiExf": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's the last day to order for Christmas delivery?",
            "icon": "none",
            "row_content": "<p>To have your book arrive by Christmas, order by these dates:</p><ul><li><strong>USA:</strong></li></ul><ol><li>Standard: Thursday, December 10</li><li>Expedited: Wednesday, December 16</li></ol><ul><li><strong>Canada:</strong></li></ul><ol><li>Standard: Tuesday, December 8</li><li>Expedited: Monday, December 14</li></ol><ul><li><strong>Europe:</strong> Tuesday, December 8</li><li><strong>Australia:</strong></li></ul><ol><li>NSW, QLD & VIC (metro): Wednesday, December 16</li><li>SA & ACT (metro): Tuesday, December 15</li><li>WA (metro): Saturday, December 12</li><li>TAS (metro): Sunday, December 13</li><li>NT (metro): Thursday, December 10</li><li>All regional/major cities: Order by Thursday, December 10 to be safe</li></ol><ul><li><strong>UK:</strong></li></ul><ol><li>Standard: Monday, December 14</li><li>Express: Tuesday, December 15</li></ol><ul><li><strong>Rest of the world:</strong> Order as early as you can</li></ul><p>Delivery times can change for reasons outside our control, so we can't guarantee arrival by Christmas. Ordering early gives your book the best chance.</p>",
            "page": ""
          }
        },
        "collapsible_row_nWynkz": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long is delivery?",
            "icon": "none",
            "row_content": "<p>Your book is made for you, printed on demand. Add the estimated production time to the shipping time below for an estimated delivery date:<br/><br/><strong>Estimated production time</strong>:<br/></p><ul><li><strong>USA</strong>: 3-4 business days</li><li><strong>Canada</strong>: 3-4 business days</li><li><strong>UK</strong>: 2-3 business days</li><li><strong>Australia</strong>: 3-4 business days</li><li><strong>New Zealand</strong>: 3-4 business days</li><li><strong>EU</strong>: 4-5 business days</li><li><strong>Rest of the World</strong>:&nbsp;2-5 business days<br/></li></ul><p>We add a shipping fee to each order, which lets us keep our books top quality without raising their prices. Your shipping options and costs, which include packaging and handling, are shown at checkout after you enter your delivery address.</p><p><strong>Estimated shipping time</strong>:</p><ul><li><strong>USA (48 contiguous states):</strong>&nbsp;1-5 business days</li></ul><ol><li><strong>Alaska:</strong>&nbsp;2 business days</li><li><strong>American Samoa:</strong>&nbsp;1-5 business days</li><li><strong>Guam:</strong>&nbsp;1-5 business days</li><li><strong>Hawaii:</strong>&nbsp;1-2 business days</li><li><strong>Northern Mariana Islands:</strong>&nbsp;1-5 business days</li><li><strong>Puerto Rico:</strong>&nbsp;2-5 business days</li><li><strong>U.S. Minor Outlying Islands:</strong>&nbsp;1-5 business days</li><li><strong>U.S. Virgin Islands:</strong>&nbsp;1-5 business days</li></ol><ul><li><strong>Canada:</strong>&nbsp;1-5 business days</li><li><strong>UK:</strong>&nbsp;1-3 business days</li><li><strong>Australia:</strong>&nbsp;1-5 business days</li><li><strong>New Zealand:</strong>&nbsp;4-7 business days</li><li><strong>Åland Islands:</strong>&nbsp;5-6 business days</li><li><strong>Albania:</strong>&nbsp;5-8 business days</li><li><strong>Andorra:</strong>&nbsp;4-6 business days</li><li><strong>Argentina:</strong>&nbsp;8-12 business days</li><li><strong>Austria