        "custom_liquid": "<!-- Picco Puppy homepage testimonials with expandable list: paste into a Custom Liquid section on the homepage. -->\n<style>\nhtml{scroll-behavior:smooth}\n.pp-t{--ink:#121212;--mut:rgba(18,18,18,.6);--body:rgba(18,18,18,.75);--cream:#ffffff;--card:#fff;--coral:#e4684f;--gold:#f0b94d;--line:#eadfce;background:var(--cream);color:var(--ink);font-family:Assistant,sans-serif;font-size:16px;line-height:1.8;letter-spacing:.6px;color:var(--body);padding:56px max(15px,calc((100vw - 1170px)/2)) 64px;width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);box-sizing:border-box}\nbody{overflow-x:clip}\n.pp-t *{box-sizing:border-box}\n.pp-t h1,.pp-t h2,.pp-t h3{font-family:inherit;color:var(--ink);font-weight:400;letter-spacing:.6px;line-height:1.4;margin:0}\n.pp-t-hero{max-width:860px;margin:0 auto 48px;text-align:center}\n.pp-t-eyebrow{display:inline-block;margin:0 0 14px;padding:5px 14px;border-radius:999px;background:#fbe3dc;color:#b8432c;font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}\n.pp-t h1{font-size:40px;line-height:1.35;margin-bottom:14px}\n.pp-t-sub{font-size:16px;color:var(--mut);margin:0 auto 36px;max-width:620px}\n.pp-t-feature{position:relative;margin:0;text-align:left;background:var(--card);border:1px solid var(--line);border-radius:22px;padding:44px 40px 32px;box-shadow:0 10px 30px rgba(60,40,10,.08)}\n.pp-t-feature:before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:8px;border-radius:22px 0 0 22px;background:linear-gradient(var(--coral),var(--gold))}\n.pp-t-bigq{position:absolute;top:-6px;right:28px;font:400 120px/1 Assistant,sans-serif;color:#f6d9cf}\n.pp-t-feature h2{font-size:24px;font-weight:500;margin-bottom:14px;position:relative}\n.pp-t-feature .pp-t-body p{font-size:16px;margin:0 0 12px;position:relative}\n.pp-t-feature figcaption{margin-top:18px;display:flex;flex-wrap:wrap;gap:6px 10px;align-items:baseline;font-size:15px}\n.pp-t-feature figcaption span,.pp-t-card footer span{color:var(--mut)}\n.pp-t-grid{max-width:none;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:22px;align-items:start}\n.pp-t-grid.pp-t-js{display:flex;gap:22px;align-items:flex-start}\n.pp-t-col{flex:1 1 0;min-width:0;display:flex;flex-direction:column;gap:22px}\n.pp-t-card{position:relative;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:30px 26px 22px;box-shadow:0 4px 14px rgba(60,40,10,.05);transition:transform .2s,box-shadow .2s}\n.pp-t-card:hover{transform:translateY(-3px);box-shadow:0 10px 26px rgba(60,40,10,.1)}\n.pp-t-qm{position:absolute;top:2px;left:18px;font:400 64px/1 Assistant,sans-serif;color:#f6d9cf}\n.pp-t-card h3{font-size:20px;font-weight:500;line-height:1.3;margin:14px 0 10px;position:relative}\n.pp-t-body p{margin:0 0 10px;font-size:15px;line-height:1.8}\n.pp-t-card footer{margin-top:16px;padding-top:14px;border-top:1px dashed var(--line);display:flex;flex-wrap:wrap;gap:4px 8px;align-items:baseline;font-size:14px}\n.pp-t-chip{margin-left:auto;background:#e6f2ec;color:#2d6a4f;border-radius:999px;padding:2px 10px;font-size:12px;font-weight:700}\n.pp-t-band{max-width:none;margin:56px auto 0}\n.pp-t-band h2{font-size:28px;text-align:center;margin-bottom:24px}\n.pp-t-qs{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}\n.pp-t-q{margin:0;background:#fff3df;border-radius:16px;padding:22px 22px 18px}\n.pp-t-q blockquote{margin:0 0 10px;font-size:16px;line-height:1.7;font-style:normal}\n.pp-t-q figcaption{font-size:14px;font-weight:700;color:#b8432c}\n.pp-t-q figcaption span{display:block;margin-top:2px;font-weight:400;font-style:italic;font-size:14px;color:var(--mut)}\n.pp-t-sv{background:#e9eefb}.pp-t-sv figcaption{color:#3b4a8a}\n.pp-t-cta{max-width:760px;margin:64px auto 0;text-align:center;background:#121212;color:#fff;border-radius:0;padding:48px 28px}\n.pp-t-cta h2{color:#fff;font-size:28px;margin-bottom:10px}\n.pp-t-cta p{margin:0 auto 24px;max-width:520px;color:#e6e6e6;font-size:16px}\n.pp-t-btns{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}\n.pp-t-btn{display:inline-block;border-radius:0;background:#fff;color:#121212!important;font-weight:400;letter-spacing:1px;text-decoration:none!important;font-size:15px;line-height:47px;padding:0 30px}\n.pp-t-btn:hover{background:#e6e6e6}\n.pp-t-ghost{background:transparent;border:2px solid #fff}.pp-t-ghost:hover{background:rgba(255,255,255,.12)}\n.pp-t .pp-t-note{margin:28px auto 0;font-size:13px;color:#aab1cf}\n@media(min-width:750px){.pp-t{padding-left:max(50px,calc((100vw - 1100px)/2));padding-right:max(50px,calc((100vw - 1100px)/2))}}\n@media(max-width:749px){.pp-t h1{font-size:28px}.pp-t-band h2,.pp-t-cta h2{font-size:20px}.pp-t-feature h2{font-size:20px}}\n@media(max-width:640px){.pp-t{padding-top:36px;padding-bottom:48px}.pp-t-feature{padding:36px 22px 24px}.pp-t-feature .pp-t-body p{font-size:17px}}\n\n.pp-t.pp-t-home{padding-top:40px;padding-bottom:48px}.pp-t-home .pp-t-title{text-align:center;font-size:28px;margin:0 0 28px}.pp-t-more{text-align:center;margin-top:36px}.pp-t-btn.pp-t-dark{background:#121212;color:#fff!important}.pp-t-btn.pp-t-dark:hover{background:#333}.pp-t-home .pp-t-band{margin-top:48px}@media(max-width:749px){.pp-t-home .pp-t-title{font-size:20px}}\n.pp-t [hidden]{display:none!important}.pp-t-more button.pp-t-btn{border:0;cursor:pointer;font-family:inherit}.pp-t-extra{margin-top:48px}.pp-t-extra .pp-t-grid{margin-top:0}.pp-t-home .pp-t-extra .pp-t-band{margin-top:48px}\n.pp-t-card h3 { font-weight: 700 !important; }\n@media(max-width:749px){.pp-t-home .pp-t-grid.pp-t-fixed{grid-template-columns:1fr!important}}\n.pp-t-home:not(.pp-t-open) .pp-t-later{display:none}\n</style>\n<div class=\"pp-t pp-t-home\" id=\"pp-t\">\n  <h2 class=\"pp-t-title\">Kind words from the families who read our books</h2>\n  <section class=\"pp-t-grid pp-t-fixed\" style=\"align-items:stretch;grid-template-columns:repeat(3,minmax(0,1fr))\" aria-label=\"Customer testimonials\">\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>My two High School graduates LOVE this book</h3><div class=\"pp-t-body\"><p>I love to give children’s beautifully illustrated books to people for many occasions. I happened to find this one as I was searching for the perfect sentiment for my daughter and her best friend as they graduated from high school last week. \"I Wish You Happiness\" was the perfect find in both the beautiful, sweet, colorful illustrations and the words, which are so fitting for any transition, which in this case is sending them off to college. The author said everything I wished for them and yes, a few tears were shed.</p></div><footer><strong>Susan</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>The PERFECT Gift!</h3><div class=\"pp-t-body\"><p>I was looking for a book to gift to my son for his high school graduation-granted he just finished Kindergarten but I plan on having his teachers write a little something in the book each year and gift the final book to him as a surprise when he graduates his senior year. This book embodies what we are teaching him and what we hope he carries throughout his life - we wish him happiness! The book itself is absolutely amazing - the illustrations are beautiful which match the words throughout the book…the PERFECT gift!</p></div><footer><strong>Rosie</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Absolutely gorgeous book</h3><div class=\"pp-t-body\"><p>I really loved the previews on Kickstarter but when they arrived I was just enchanted by the details in the drawings. So much joy in them. Definitely illustrations you could explore for a long time with the little person you like to read with. I bought several copies to send to my friends’ kids.</p><p>PS: seeing Amelia Earhart made my eyes fog up a little bit. Or a lot? A lot.</p></div><footer><strong>Claire Kelly</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card pp-t-later\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Amazing and beautiful book</h3><div class=\"pp-t-body\"><p>This book is absolutely beautiful. I am obsessed with it. I teared up the first time I read it!! The illustrations are stunning too!! Such a good book to have for your children!!!</p></div><footer><strong>Allee</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card pp-t-later\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>A Gorgeous Book with a Gorgeous Story</h3><div class=\"pp-t-body\"><p>This book is such a fantastic read! Not only is the book beautifully written, but the illustrations capture the love and adoration wrapped within the text. Any parent reading this to their child just might tear up at how touching this book is.</p></div><footer><strong>Melquea Smith</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card pp-t-later\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Inspiring book</h3><div class=\"pp-t-body\"><p>Beautiful captivating words and pictures. Be warned it’s a bit of a tearjerker!</p></div><footer><strong>Anneliese Constantine</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n  </section>\n  <section class=\"pp-t-band\">\n    <h2>The care behind every book</h2>\n    <div class=\"pp-t-qs pp-t-qs4\"><figure class=\"pp-t-q pp-t-sv\"><blockquote>These are beautiful books that will be cherished for years to come! The customer service at Picco Puppy is outstanding.</blockquote><figcaption>Judy G<span>The Complete Unconditional Love Series</span></figcaption></figure><figure class=\"pp-t-q pp-t-sv\"><blockquote>The creator is a wonderful person who kept me up to date on all things big and small. 10/10</blockquote><figcaption>Jacob Cookman<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q pp-t-sv\"><blockquote>I was kept updated all through the ordering process. I am very satisfied with my purchase.</blockquote><figcaption>Diane Hetzer<span>I Wish You Happiness</span></figcaption></figure></div>\n  </section>\n  <div class=\"pp-t-extra\" id=\"pp-t-extra\" hidden>\n    <section class=\"pp-t-grid\" id=\"pp-t-more-grid\" aria-label=\"More testimonials\">\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Breathtakingly beautiful!!</h3><div class=\"pp-t-body\"><p>This book completely captivated my three youngest children, all boys ages 2, 4 &amp; 8. They LOVED the sweet words and message of the book.</p><p>We read the book aloud and took our time turning the pages. The details and the artwork are truly unbelievable. I found myself after several minutes encouraging a page-turn as they could have stared at each page for hours. Such a good buy and a keepsake for our collection!! HIGHLY recommend!</p></div><footer><strong>Katie Weaver</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Amazing gift</h3><div class=\"pp-t-body\"><p>I’m currently pregnant with my first child. I was gifted this book from my grandparents with my baby’s name on it and I absolutely love it! It’s by far my favorite book I’ve received and I know my baby is going to love it just as much as me. The personalization makes it more sentimental and it will be forever cherished.</p></div><footer><strong>Shekinah Amos</strong><span>on <em>I Wish You Happiness</em></span><span class=\"pp-t-chip\">Personalized</span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Absolutely beautiful</h3><div class=\"pp-t-body\"><p>Where do I begin! This is just my absolute favourite book at the moment. I love everything about it! The beautiful writing with the magical illustrations have created a masterpiece. A book to be treasured young and old!</p></div><footer><strong>Chandni</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Heartwarming and Captivating Children’s Book, I Wish You Happiness</h3><div class=\"pp-t-body\"><p>This book is beautifully illustrated with a storyline that is amazing. I cannot express adequately how much I loved giving this as a gift to our great granddaughter. She has an extensive library of children’s books. Without a doubt, this is one of her favorites and mine. To read this together is heartwarming. I highly recommend this book as a lasting gift to give to any child in your life.</p></div><footer><strong>D. Hetzer</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Awesome Book</h3><div class=\"pp-t-body\"><p>You know how you love your kids so much and you want the best for them so bad but sometimes you don’t know how to put the enormity of your emotions on paper? Lol, maybe I’m the only one with this problem, but I loved that this book helped me put to words the wealth of emotion and good vibes I feel for my kids. This is an awesome awesome book and my kids loved it.</p></div><footer><strong>Jennifer Aire</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>I wish you happiness</h3><div class=\"pp-t-body\"><p>I love this book, the colours and characters are truly beautiful. I purchased it to read to my twin granddaughters, as I want them both to believe in themselves, but even more importantly, I want them to be happy within themselves and I encourage all parents and grandparents to do this too.</p></div><footer><strong>Sherryn Chapman</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>An absolutely beautiful book</h3><div class=\"pp-t-body\"><p>What a beautiful book. Not only are the words heartfelt, but the illustrations are just stunning. This book is a classic and will be cherished for years to come. Michael also has amazing customer service. I received an email the minute I ordered (which was 10pm at night hehe) and also when the book was posted and once more to check it arrived. Thank you so much Michael!</p></div><footer><strong>Sarah Cullen</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Very special, every home should have one!</h3><div class=\"pp-t-body\"><p>Dear Michael, thank you so very much for your gorgeous book. If my youngest granddaughter loves it as much as her older sister I may have to get another one! The delivery was prompt and hassle free, your email contact is lovely, and the packaging and presentation on arrival was just beautiful. Thank you for sharing your talent, your words are meaningful and inspirational. It truly is a book that every child should have.</p></div><footer><strong>Lorraine Robbie</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Just beautiful</h3><div class=\"pp-t-body\"><p>This book is a masterpiece. I want to frame the illustrations and put them on my walls. The words are tender and beautiful too - you can use them. In cards you give to friends and family. Wonderful wishes.</p></div><footer><strong>Diana A</strong><span>on <em>I Wish You Happiness</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Beautiful Words, Lovely Illustrations and Amazing Service</h3><div class=\"pp-t-body\"><p>Every part of our experience was perfect. From the easy ordering, great communication and personalised experience from Michael Wong to receiving a signed, wrapped and beautifully written and illustrated book filled with positive wishes that is perfect for our new baby’s first book. Very quick processing time and shipping even amidst a covid lockdown. 5 stars all round!</p></div><footer><strong>Jayde Stapleton</strong><span>on <em>I Wish You Happiness</em></span><span class=\"pp-t-chip\">Personalized</span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Extra Special!</h3><div class=\"pp-t-body\"><p>Such a beautiful and heartfelt story! It brought tears to my eyes as my mom read it to my son. I look forward to hearing my mom read this book to my son throughout the years. We will cherish this special book forever. ❤️</p><p>Another wonderful book from Michael Wong filled with heart, soul, and amazing artistry. I’m so glad I added this book to my son’s collection. I highly recommend this book (and all of the books in Michael’s collection) for any family. They make a great gift too! Looking forward to more books! 😊</p></div><footer><strong>Melissa</strong><span>on <em>Grandma’s Timeless Wisdom</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Truly Inspiring</h3><div class=\"pp-t-body\"><p>The books are really lovely and special. My husband got teary-eyed when I showed them to him. Forever grateful!</p></div><footer><strong>Danielle S.</strong><span>on <em>Share The Kindness In Your Heart</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>A beautiful work of art to have in your home</h3><div class=\"pp-t-body\"><p>My son loves to find the dog on each page. I love the writing and tear up often when reading this book. A beautiful work of art to have in your home.</p></div><footer><strong>Dani</strong><span>on <em>I Love You With All My Heart</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Cherished</h3><div class=\"pp-t-body\"><p>I wanted to buy something for my grandchildren who are 4.5 &amp; 2.5 and they LOVE BOOKS!! Probably more than their toys. When I received the Grandmas Wisdom book, I was very impressed. It led me to the UNCONDITIONAL SERIES. I immediately knew that I had to have them. I was more than impressed by the quality and the perfection of these books. I was so happy that I immediately wrote a loving message to them from Grandma. I also asked my daughter to keep them out of the kids’ bookcases because I wanted them to remain safe and cherished. I can’t wait for more grandchildren to bless my life so I can order more sets.</p></div><footer><strong>Kimberly F</strong><span>on <em>The Complete Unconditional Love Series</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>1st Birthday</h3><div class=\"pp-t-body\"><p>If you are looking for a book or books to convey a message to your loved ones look no further than the books written by Michael Wong. Each book lets your loved one know they are loved by you and you wish them all the best life has to offer.</p><p>I bought the book \"I Wish You A Happy Birthday\" along with \"I Wish Happiness\", \"I Will Always Love You\" and \"I Will Always Be Proud Of You\" for our granddaughter’s first birthday. My hope is that my granddaughter will read one or all of the books every year on her birthday and remember her gamma wants her to be a strong, independent, giving person and she is loved.</p></div><footer><strong>Danielle Skajewski</strong><span>on <em>I Wish You A Happy Birthday</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Truly timeless — a book that every parent/caregiver should have!</h3><div class=\"pp-t-body\"><p>I Will Always Believe in You is an absolutely beautiful and meaningful book. From the very first page, I was touched by the loving message that shines through each word.</p><p>I plan to use this book as a special keepsake for my daughter. Each of her teachers will write a note to her at the end of their year together, making it a treasured memory she can look back on as she grows.</p><p>This book puts into words everything I want my child to know: that I will always believe in her, in every stage of her life.</p></div><footer><strong>Nayeli C</strong><span>on <em>I Will Always Believe In You</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Charismatic Stories &amp; Messages</h3><div class=\"pp-t-body\"><p>I first came across these books on Amazon (in softcover), when I was looking for a personalized book for my oldest daughter. I simply loved everything about them, from the positive messaging, to the beautiful illustrations created by multiple talented illustrators. I continued to buy each book I came across until I had all of the books I could get.</p><p>Then, for my youngest daughter’s 1st Birthday, I decided to get the personalized hardcovers for her. Given her unique name, I had to special order them directly through the author, Michael. He was so kind, and communicated with me until I got the books, to ensure I received everything perfectly. I decided to gift these to her because I wanted something special, unique, memorable, and even more so, something she could learn from and cherish.</p><p>For both of my girls, I hope they keep these books as keepsakes and have wonderful memories of us reading them together. 🩷</p></div><footer><strong>Ashley S.</strong><span>on <em>The Complete Unconditional Love Series</em></span><span class=\"pp-t-chip\">Personalized</span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Beautiful and timeless books!</h3><div class=\"pp-t-body\"><p>We purchased The Complete Unconditional Love Series for my child. These books are so beautiful! Gorgeous illustrations, thoughtful writing, excellent quality of hardcover books. Sometimes it can be hard to put into words the feelings you have as a parent for your child and these books have just the right words, they are very encouraging and inspiring. I am sure this will be a true keepsake for her and she will love them even more when she understands the true meaning of the words.</p></div><footer><strong>Lilit P.</strong><span>on <em>The Complete Unconditional Love Series</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Simply beautiful!</h3><div class=\"pp-t-body\"><p>These books are truly beautiful! The words, the illustrations. Love pouring out of every page. We own every book from the Unconditional Love series including a couple of personalised copies and we will treasure them forever. They will definitely be put into our children’s keepsake boxes for their children to enjoy one day.</p></div><footer><strong>Eva M</strong><span>on <em>I Will Always Love You</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Unconditional love for the new family</h3><div class=\"pp-t-body\"><p>I ordered these books for new parents. What could be better than books about unconditional love?! The books arrived in great shape and the personal messages from Michael are a special touch that further emphasizes the authenticity of the beautiful emotions and life lessons contained in this series. If all children learned these lessons we would have world peace. Thank you Michael!</p></div><footer><strong>Michele</strong><span>on <em>The Complete Unconditional Love Series</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Recommended read to every child by every caregiver</h3><div class=\"pp-t-body\"><p>Absolutely love this book (and author!).</p><p>We also love the diversity in both books we’ve read so far and that it shows children with different abilities and of different skin tones so each child feels seen and can also be taught about children who are different from them too.</p><p>We recommended both books to our group of prospective foster parents because we believe the message in both is necessary for kids in care. Highly recommended to build confidence in young children.</p></div><footer><strong>Derek T</strong><span>on <em>I Will Always Believe In You</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Sweet and special</h3><div class=\"pp-t-body\"><p>If you’re a grandmother you’ve probably had many of these same conversations with your grandchildren. I know I have. This book is a sweet reminder of all the times you’ve spent with your grandchildren, all the memories you’ve already shared with them, and all the future memories you will make with them. Reading this book made me smile and remember all the wonderful moments I’ve been able to spend with them. I can’t wait to read it to them and give it to them so they can read it whenever they want. I loved it!</p></div><footer><strong>Annie B.</strong><span>on <em>Grandma’s Timeless Wisdom</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Another heartwarming book by Michael</h3><div class=\"pp-t-body\"><p>I have several of Michael’s books and I am never disappointed. The same goes for this book! I bought several of \"Grandma’s Timeless Wisdom\" books and gifted them to my friends, who are also grandmas. Everyone loves the book! Thank you, Michael, for another book for us to treasure!</p></div><footer><strong>Sue D</strong><span>on <em>Grandma’s Timeless Wisdom</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Heartwarming Messages Every Child Should Hear!</h3><div class=\"pp-t-body\"><p>We received our first book as a gift from a family friend and immediately fell in love with the heartwarming messages, beautiful illustrations and theme of the book. Since receiving the full collection, we’ve begun reading each book before bed as part of our daily routine. What we love as parents is the message each book offers to our baby. The messages are those that we believe all children should hear from their parents or loved ones. These books will be a staple for us and we’ve already begun gifting our favorites to other families, too!</p></div><footer><strong>Lisa C</strong><span>on <em>The Complete Unconditional Love Series</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Books for young and old</h3><div class=\"pp-t-body\"><p>I came across the Picco Puppy Unconditional Love series after purchasing Grandma’s Timeless Wisdom. My grandsons loved the book so I wanted similar life lesson books to give them for Christmas. Not only did I find the Unconditional Love series at a discounted price, Michael also made sure I received them in time for Christmas. They are currently wrapped and under the tree. I know I will be reading the books to my young grandsons for days and weeks to come.</p></div><footer><strong>Kelly</strong><span>on <em>The Complete Unconditional Love Series</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Best children’s books!</h3><div class=\"pp-t-body\"><p>I Wish You Happiness and I Will Always Love You are 2 books my son’s father customized for him with his name and gifted me while I was pregnant. These books are so touching and make a special gift for your child or any loved one! I highly recommend starting your own collection. 😊</p></div><footer><strong>Melissa</strong><span>on <em>The Complete Unconditional Love Series</em></span><span class=\"pp-t-chip\">Personalized</span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Share The Kindness In Your Heart</h3><div class=\"pp-t-body\"><p>As a first-grade teacher welcoming my 38th group of students this month, I am always looking for meaningful resources for our first week together. Earlier this year, my classroom library was incredibly impacted by Wong’s I Wish You Happiness. My students fell in love with it and requested it for Read Aloud three times during our last week together. This book is just as powerful.</p><p>It is already a beloved resource in my classroom, and I highly recommend it to any educator or parent looking to foster empathy and compassion in children.</p></div><footer><strong>Robyn</strong><span>on <em>Share The Kindness In Your Heart</em></span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>I Wish You A Happy Birthday</h3><div class=\"pp-t-body\"><p>I purchased a personalized book for my son’s first birthday and absolutely love it! The entire process was seamless, thanks to Michael Wong, who was incredibly helpful and responsive, going back and forth with me through email to make sure every detail was perfect and exactly what I envisioned. I was even able to include a personalized message, which makes the book extra special. This is something I’ll cherish forever, and it’s so meaningful knowing my son will grow up with it and always have a keepsake to remember his first birthday.</p></div><footer><strong>Roxana H</strong><span>on <em>I Wish You A Happy Birthday</em></span><span class=\"pp-t-chip\">Personalized</span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>Fantastic!</h3><div class=\"pp-t-body\"><p>I wanted a personalised book for my son whose name is rarely featured on generic personalised items. I contacted the company who, from start to finish, gave excellent customer service! My books arrived prompt, immaculately presented and beautiful. Thank you!</p></div><footer><strong>Amy</strong><span>on <em>I Love You With All My Heart</em></span><span class=\"pp-t-chip\">Personalized</span></footer></article>\n<article class=\"pp-t-card\"><div class=\"pp-t-qm\" aria-hidden=\"true\">“</div><h3>We love the books</h3><div class=\"pp-t-body\"><p>We love these books! Our little one grows up bilingual and not one day goes by without reading these 2 books at least 4 times. The German translation is really great!</p></div><footer><strong>Josephine Werner</strong><span>on <em>I Will Always Be Proud of You</em></span></footer></article>\n    </section>\n    <section class=\"pp-t-band\">\n      <h2>A few more kind words</h2>\n      <div class=\"pp-t-qs\"><figure class=\"pp-t-q\"><blockquote>This book says everything my heart feels in wishing those I care for happiness!</blockquote><figcaption>Julie Fletcher<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>What a beautiful, incredibly uplifting book. I’m sure my daughter will keep it always.</blockquote><figcaption>Kyrilee B<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>I can’t get over how incredible the illustrations are in this beautiful book, and every wish written is a wish I wish for my daughters.</blockquote><figcaption>Jamie Bills<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>Absolutely magical book, would recommend for anyone looking to buy a gift for those both big and small.</blockquote><figcaption>Winter Rosengreen<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>I received my books today and I was absolutely blown away by just how beautiful they are! The quality is amazing!</blockquote><figcaption>Lauren Taylor<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>This book is a combination of reaching for your dreams and never giving up.</blockquote><figcaption>Annie B.<span>Be The Best You Can Be</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>This is one of my great granddaughter’s favorite books. She loves the pictures and we read her the story.</blockquote><figcaption>Sue Lucas<span>I Love You With All My Heart</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>Anyone who purchases this book will not be disappointed.</blockquote><figcaption>Rhonda Doyle<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>This is a beautiful, enchanting, inclusive and diverse book with both heartfelt words and stunning pictures.</blockquote><figcaption>Jennifer Baggaley<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>Purchased a class set as an end-of-year gift, and my students loved it.</blockquote><figcaption>Alondra Flores<span>I Wish You Happiness</span></figcaption></figure><figure class=\"pp-t-q\"><blockquote>This is my favorite book and the fact that everything was so accommodating and easy to get a bulk order for our preschool graduation made it even better!</blockquote><figcaption>Brittany Lowstan<span>I Wish You Happiness</span></figcaption></figure></div>\n    </section>\n  </div>\n  <div class=\"pp-t-more\"><button type=\"button\" class=\"pp-t-btn pp-t-dark\" id=\"pp-t-toggle\" aria-expanded=\"false\" aria-controls=\"pp-t-extra\">More testimonials</button></div>\n</div>\n<script>\n(function(){\n  var btn=document.getElementById('pp-t-toggle'), box=document.getElementById('pp-t-extra'), grid=document.getElementById('pp-t-more-grid'), root=document.getElementById('pp-t');\n  if(!btn||!box||!grid) return;\n  var cards=[].slice.call(grid.children), cols=0;\n  function layout(force){\n    if(box.hidden) return;\n    var w=grid.getBoundingClientRect().width, n=w>=700?3:(w>=480?2:1);\n    if(n===cols&&!force) return; cols=n;\n    grid.classList.add('pp-t-js'); grid.innerHTML='';\n    var cs=[]; for(var i=0;i<n;i++){var d=document.createElement('div'); d.className='pp-t-col'; grid.appendChild(d); cs.push(d);}\n    cards.forEach(function(c){ var s=cs[0]; cs.forEach(function(d){ if(d.offsetHeight<s.offsetHeight) s=d; }); s.appendChild(c); });\n  }\n  btn.addEventListener('click',function(){\n    var open=box.hidden;\n    box.hidden=!open;\n    root.classList.toggle('pp-t-open',open);\n    btn.setAttribute('aria-expanded',open?'true':'false');\n    btn.textContent=open?'Show fewer testimonials':'More testimonials';\n    if(open){ cols=0; layout(true); } else { root.scrollIntoView({behavior:'smooth',block:'start'}); }\n  });\n  window.addEventListener('resize',function(){layout(false);});\n})();\n</script>",
