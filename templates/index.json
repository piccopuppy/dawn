        "text_Bz8Lpy": {
          "type": "text",
          "disabled": true,
          "settings": {
            "text": "The Unconditional Love Series (Book 1 of 9) <strong>Mom's Choice Awards® Gold Award2021 Readers' Favorite Book Awards Gold Medal Winner2021 Readers' Favorite Illustration Award Winner</strong>2021 International Book Awards Winner2020 Wishing Shelf Book Awards Winner2020 National Indie Excellence Awards Winner2020 Foreword Indies Book of The Year Awards Finalist",
            "text_style": "body"
          }
        },
        "custom_liquid_8jQeMQ": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<p><img style=\"max-width: 100%;\" alt=\"\" src=\"https://cdn.shopify.com/s/files/1/0267/7286/5217/files/6-Awards-1Row-720x119_203cffe2-175a-42e6-abe0-0031f209d197.png?v=1696501261\" width=\"440px\"></p>\n<p><meta charset=\"utf-8\">The Unconditional Love Series (Book 1 of 9) </p>\n<p><strong>Mom's Choice Awards® Gold Award</strong><br><strong>2021 Readers' Favorite Book Awards Gold Medal Winner</strong><br><strong>2021 Readers' Favorite Illustration Award Winner</strong><br>2021 International Book Awards Winner<br>2020 Wishing Shelf Book Awards Winner<br>2020 National Indie Excellence Awards Winner<br>2020 Foreword Indies Book of The Year Awards Finalist</p>\n<p class=\"p1\">This timeless classic, created by an award-winning author and award-winning illustrator, is filled with heartfelt wishes to inspire children to dream big, stand tall, and believe in themselves. From spreading their wings and embracing adventure to showing kindness and never giving up, each page is a powerful reminder that they are strong, capable, and limitless.</p>\n<p class=\"p1\"><meta charset=\"utf-8\"><span><meta charset=\"utf-8\">This beautiful book is perfect for baby showers, birthdays, Christmas, or simply to say, \"I love you.\"</span></p>\n<p class=\"p1\">Join thousands of teachers, grandparents, and parents to discover why so many love and recommend the <em>Unconditional Love Series</em> of empowering children’s picture books.</p>\n<p><strong>REVIEWS</strong></p>\n<p>\"I Wish You Happiness is the most perfect gift EVER for a young child's birthday. Or, even better, a christening present. Highly recommended!\"<em> (5-Star Review) - The Wishing Shelf</em></p>\n<p>\"An excellent baby shower gift or a whimsical graduation present.\"<em> - (Editor's Pick) Publishers Weekly's BookLife</em></p>\n<p>\"A warm hug of a picture book wishing all children happy, fulfilled, and meaningful lives.\"<em> - Kirkus Reviews</em></p>\n<p>\"This uplifting book is filled with positive and beautiful messages that will inspire young readers...a highly recommended and inspiring read.\"<em> - (5 Stars) Melinda Facal, Readers' Favorite</em></p>\n<p><strong>PRODUCT DETAILS</strong></p>\n<ul>\n<li>\n<strong>Age Range</strong>: ‎Baby - 6 years</li>\n<li>\n<strong>Pages</strong>: ‎39</li>\n<li>\n<strong>Printing</strong>: US · Canada · UK · Europe · Australia</li>\n<li>\n<strong>Dispatch</strong>: 2-5 working days</li>\n</ul>"
          }
        }
      },
