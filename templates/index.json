        "custom_liquid": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Mrs+Saint+Delafield&display=swap\" rel=\"stylesheet\">\n<style>\n.pp-promise{display:flex;align-items:center;justify-content:center;gap:32px;max-width:760px;margin:32px auto;padding:28px 32px;box-sizing:border-box;background:#FBF7EE;border:1px solid #D4AD6A}\n.pp-promise__seal{flex:0 0 auto;width:200px;height:auto;display:block}\n.pp-promise__text{flex:1 1 auto;text-align:left}\n.pp-promise__eyebrow{margin:0 0 8px;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(18,18,18,.6)}\n.pp-promise__msg{margin:0;font-size:17px;line-height:1.6;color:rgba(18,18,18,.85)}\n.pp-promise__sig{margin:24px 0 0;font-family:'Mrs Saint Delafield','Brush Script MT',cursive;font-size:56px;line-height:1;color:#16263D}\n.pp-promise__role{margin:0;font-size:14px;color:rgba(18,18,18,.65)}\n@media (max-width:600px){\n  .pp-promise{flex-direction:column;gap:16px;text-align:center;padding:24px 20px}\n  .pp-promise__text{text-align:center}\n  .pp-promise__seal{width:160px}\n  .pp-promise__sig{margin-top:28px}\n}\n</style>\n<div class=\"pp-promise\">\n  <img class=\"pp-promise__seal\" src=\"https://cdn.shopify.com/s/files/1/0267/7286/5217/files/Love-It-Guarantee-Seal-608x608.gif?v=1792027415\" alt=\"Love it or we'll make it right. 12-month guarantee.\" width=\"200\" height=\"200\" loading=\"lazy\">\n  <div class=\"pp-promise__text\">\n    <p class=\"pp-promise__eyebrow\">My personal promise</p>\n    <p class=\"pp-promise__msg\">I want your child to love their book. If it isn’t everything you hoped for, email me any time in the first 12 months and I’ll make it right.</p>\n    <p class=\"pp-promise__sig\">Michael Wong</p>\n    <p class=\"pp-promise__role\">Author &amp; Founder, Picco Puppy&reg;</p>\n  </div>\n</div>",
